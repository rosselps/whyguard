{
  "name": "whyguard",
  "private": true,
  "version": "0.1.0",
  "description": "WhyGuard - Decision provenance and historical behavior protection for code changes.",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "whyguard": "tsx apps/cli/src/index.ts",
    "whyguard:demo:seed": "tsx packages/test-fixtures/src/build-payment-fixture.ts",
    "whyguard:install-hooks": "tsx apps/cli/src/index.ts install-hooks",
    "whyguard:verify-agent-work": "tsx apps/cli/src/index.ts verify --scope working-tree",
    "whyguard:init": "tsx apps/cli/src/index.ts init",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/js": "10.0.1",
    "@types/node": "22.10.5",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.7.0",
    "husky": "9.1.7",
    "lint-staged": "17.1.0",
    "prettier": "3.9.6",
    "turbo": "2.3.3",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.65.0",
    "vitest": "3.2.7"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}

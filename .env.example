NODE_ENV=development
LOG_LEVEL=info
PORT=3000

DATABASE_URL=file:./data/whyguard.db

GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

AWS_REGION=us-east-1
BEDROCK_MODEL_ID=

# Required before exposing the API on a public URL. The read routes return every
# repository's analysis history (file paths, changed code fragments, evidence), so
# with this unset the API only answers loopback clients and every remote request gets
# a 401. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WHYGUARD_API_TOKEN=

# Browser origins allowed to call the read routes. A deployed dashboard must be named here
# or every request from it fails CORS. Unset means the local Vite server only.
# Example: WHYGUARD_DASHBOARD_ORIGINS=https://main.d1234.amplifyapp.com
WHYGUARD_DASHBOARD_ORIGINS=

# The only way to serve a caller with no credential at all: a comma-separated list of
# owner/repo whose analyses anyone may read. Use it for a public demo dashboard. An
# allow-list rather than a flag, so what is exposed equals what somebody typed here —
# a repository added to the GitHub App later stays private by default.
# Example: WHYGUARD_PUBLIC_REPOS=rosselps/whyguard-demo
WHYGUARD_PUBLIC_REPOS=

# Largest base repository a webhook scan will clone, in megabytes. WhyGuard clones full
# history, so disk usage follows the repository rather than the pull request. Default ~2048.
WHYGUARD_MAX_REPO_SIZE_MB=

WHYGUARD_REPO_ROOT=
WHYGUARD_API_URL=http://localhost:3000
WHYGUARD_TEMP_ROOT=.tmp/whyguard
WHYGUARD_BLOCK_RISK=80
WHYGUARD_BLOCK_CONFIDENCE=75
WHYGUARD_LLM_ENABLED=false
